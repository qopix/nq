// std.mem — работа с памятью (внутри нужны указатели, поэтому библиотека доверенная)
// Подключение: import "std.mem"

fn fill(p: ptr<u8>, v: u8, n: i64) -> void {
    var i = 0
    while i < n {
        deref(p + i) = v
        i += 1
    }
}

fn copy(dst: ptr<u8>, src: ptr<u8>, n: i64) -> void {
    var i = 0
    while i < n {
        deref(dst + i) = deref(src + i)
        i += 1
    }
}

fn zero(p: ptr<u8>, n: i64) -> void {
    fill(p, 0, n)
}

// простой "bump"-аллокатор для ядер: heap_init(начало, размер), потом kalloc(n)
var heap_cur: i64 = 0
var heap_end: i64 = 0

fn heap_init(base: i64, size: i64) -> void {
    heap_cur = base
    heap_end = base + size
}

fn kalloc(n: i64) -> ptr<u8> {
    let sz = (n + 15) & ~15
    if heap_cur + sz > heap_end {
        return nil
    }
    let p = cast(ptr<u8>, heap_cur)
    heap_cur += sz
    return p
}
