$mid

// Обычная программа с системными вызовами Linux: аргументы, pid, файл.
//   nqc run syscalls.nq

import "std.os"

fn main() {
    print("аргументов: ")
    puti(argc())
    print("\n")
    var i = 0
    while i < argc() {
        print_cstr(argv(i))
        print("\n")
        i += 1
    }
    print("pid: ")
    puti(getpid())
    print("\n")

    // пишем файл и читаем обратно
    let fd = sys_open(cbytes("/tmp/nq-test.txt"), O_WRONLY | O_CREAT | O_TRUNC, 420)
    fd_puts(fd, "привет из файла, записано на Nq\n")
    sys_close(fd)

    let buf = make(u8, 128)
    let rd = sys_open(cbytes("/tmp/nq-test.txt"), O_RDONLY, 0)
    let n = sys_read(rd, buf, 128)
    sys_close(rd)
    sys_write(STDOUT, buf, n)
    sys_unlink(cbytes("/tmp/nq-test.txt"))
    return 0
}
