$hight

// Массивы без unsafe: make(T, n) выделяет нулевую память, p[i] — элемент.
// Границы не проверяются.

fn sum(a: ptr, n: i64) -> i64 {
    var s = 0
    for let i = 0; i < n; i += 1 {
        s += a[i]
    }
    return s
}

fn main() {
    let n = 10
    let a = make(i64, n)
    for let i = 0; i < n; i += 1 {
        a[i] = i * i
    }
    puti(sum(a, n))
    print("\n")

    let b = make(u8, 4)
    b[0] = 200
    b[1] = 55
    puti(b[0] + b[1])
    print("\n")
    return 0
}
