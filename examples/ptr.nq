$mid

// $mid разрешает небезопасное: cast между ptr и числами, арифметику указателей.
import "std.mem"

fn swap(a: ptr, b: ptr) -> void {
    let t = deref(a)
    deref(a) = deref(b)
    deref(b) = t
}

fn main() {
    var x = 1
    var y = 2
    swap(addr(x), addr(y))
    puti(x)
    print(" ")
    puti(y)
    print("\n")

    // память из системы: alloc даёт ptr<u8>, приводим к ptr<i64>
    let nums = cast(ptr<i64>, alloc(32))
    deref(nums) = 40
    deref(nums + 1) = 2          // указатель сдвигается на размер элемента (8 байт)
    puti(deref(nums) + deref(nums + 1))
    print("\n")

    let bytes = alloc(16)
    fill(bytes, 7, 16)
    puti(deref(bytes + 15))
    print("\n")

    puti(sizeof(i64))
    print(" ")
    puti(sizeof(u8))
    print("\n")
    return 0
}
